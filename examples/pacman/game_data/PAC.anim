# Pac-Man: chomping his way, still against a wall, caught, dying, running on the title. His pictures face right:
# the way he goes turns him (rotate to). The game moves him from the middle of a cell to the next (dgx_ge_walk.h) and
# tells him his way. His body is the mask PAC: a ghost that meets it says what follows (its hit: caught).
event left, right, up, down, stop, caught, die

script whole
    masks PAC
    rotate to 0
    frame PAC_FULL 1000ms
    hold

script right
    rotate to 0
    goto chomp

script up
    rotate to 270
    goto chomp

script left
    rotate to 180
    goto chomp

script down
    rotate to 90
    goto chomp

script chomp
    masks PAC
label chomping
    frame PAC_RIGHT_1 40ms
    frame PAC_RIGHT_2 40ms
    frame PAC_RIGHT_1 40ms
    frame PAC_FULL 40ms
    goto chomping

script still  # against a wall: his mouth half open, turned the way he went
    frame PAC_RIGHT_1 1000ms
    hold

script caught  # a ghost has him: he stands whole; the game is told (PLAY stands it all a while)
    masks
    signal SIG_CAUGHT
    frame PAC_FULL 1000ms
    hold

script dying  # upright again: his pictures of dying open up
    masks
    rotate to 0
    sound SND_DEATH
    frame PAC_DIE_0 133ms
    frame PAC_DIE_1 133ms
    frame PAC_DIE_2 133ms
    frame PAC_DIE_3 133ms
    frame PAC_DIE_4 133ms
    frame PAC_DIE_5 133ms
    frame PAC_DIE_6 133ms
    frame PAC_DIE_7 133ms
    frame PAC_DIE_8 133ms
    frame PAC_DIE_9 133ms
    frame PAC_DIE_10 133ms
    frame none 500ms
    signal SIG_GONE  # tell the game: he is gone
label gone
    frame none 1000ms
    goto gone

script parade  # entry: the title show starts it; he runs across, the ghost after him
    masks
    velocity 60 0
label parade_chomp
    frame PAC_RIGHT_1 40ms
    frame PAC_RIGHT_2 40ms
    frame PAC_RIGHT_1 40ms
    frame PAC_FULL 40ms
    goto parade_chomp

group any: whole, right, up, left, down, chomp, still

on right: any -> right now
on up: any -> up now
on left: any -> left now
on down: any -> down now
on stop: chomp -> still now
on caught: any -> caught now
on die: caught -> dying now
