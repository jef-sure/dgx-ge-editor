# The schedule of the ghosts' modes, level 1: a signal to the game as each begins. The game starts it
# with a life (an actor of its own, not drawn); its clock stands while the ghosts are frightened.
script schedule
    signal SCATTER
    frame none 7000ms
    signal CHASE
    frame none 20000ms
    signal SCATTER
    frame none 7000ms
    signal CHASE
    frame none 20000ms
    signal SCATTER
    frame none 5000ms
    signal CHASE
    frame none 20000ms
    signal SCATTER
    frame none 5000ms
    signal CHASE
label chasing  # the last chase lasts
    frame none 60000ms
    goto chasing
