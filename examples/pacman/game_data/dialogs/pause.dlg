dialog pause
roles play PLAY
game PLAY
style menu
pause
    say game "PAUSE  Score {score}  Lives {lives}"
choose play
    "Continue" -> resume
    "Music" control SLIDER game_var.music_volume
    "Effects" control SLIDER game_var.effects_volume
    "New game" -> restart
label resume
    end
label restart
    tell play restart
    end
