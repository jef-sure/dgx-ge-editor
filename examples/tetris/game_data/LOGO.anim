# The title: each letter falls in after the one before and bounces.
script letter_1
    frame none 1ms
    dy -120
    frame LOGO_LETTER_1 25ms
    dy 2
    frame LOGO_LETTER_1 25ms
    dy 5
    frame LOGO_LETTER_1 25ms
    dy 6
    frame LOGO_LETTER_1 25ms
    dy 9
    frame LOGO_LETTER_1 25ms
    dy 11
    frame LOGO_LETTER_1 25ms
    dy 13
    frame LOGO_LETTER_1 25ms
    dy 16
    frame LOGO_LETTER_1 25ms
    dy 17
    frame LOGO_LETTER_1 25ms
    dy 20
    frame LOGO_LETTER_1 25ms
    dy 21
    frame LOGO_LETTER_1 25ms
    dy -6
    frame LOGO_LETTER_1 25ms
    dy -3
    frame LOGO_LETTER_1 25ms
    dy -1
    frame LOGO_LETTER_1 25ms
    dy 1
    frame LOGO_LETTER_1 25ms
    dy 3
    frame LOGO_LETTER_1 25ms
    dy 6
label landed_1
    frame LOGO_LETTER_1 1000ms
    goto landed_1

